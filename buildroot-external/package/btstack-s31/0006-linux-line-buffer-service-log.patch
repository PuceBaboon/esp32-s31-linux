From 5d8972675872370e0256bb497f7e9b61918c6995 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Thu, 27 Aug 2026 19:30:00 +0800
Subject: [PATCH] linux: line buffer the appliance service log

The A2DP appliance redirects stdout to a persistent service log.  Keep status
and connection events visible while the process is running so controller and
transport failures can be diagnosed without terminating the service.
---
 port/linux/main.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/port/linux/main.c b/port/linux/main.c
index f8dcac012..44d74ea71 100644
--- a/port/linux/main.c
+++ b/port/linux/main.c
@@ -215,5 +215,7 @@ static void usage( const char * arg ){
 int main(int argc, const char * argv[]){
 
+    setvbuf(stdout, NULL, _IOLBF, 0);
+
     const char * log_file_path = NULL;
 
     // parse command line parameters
