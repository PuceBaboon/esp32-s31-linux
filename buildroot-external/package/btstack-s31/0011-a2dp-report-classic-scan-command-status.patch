From 7d9c16eef53db09ee9710c8927171924ee2f2ee2 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Fri, 28 Aug 2026 17:00:00 +0800
Subject: [PATCH] a2dp: report classic scan command status

Report the controller status for the three commands which establish the
Classic discoverable/connectable scan policy.  This is small operational
telemetry for the direct-HCI backend, where btmon is intentionally absent
from the target image.
---
 example/a2dp_sink_demo.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 6bc5de631..40ecdd9d1 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -857,7 +857,15 @@ static void hci_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *
             }
             break;
-        case HCI_EVENT_COMMAND_COMPLETE:
+        case HCI_EVENT_COMMAND_COMPLETE: {
+            uint16_t opcode = hci_event_command_complete_get_command_opcode(packet);
+            if (opcode == HCI_OPCODE_HCI_WRITE_PAGE_SCAN_ACTIVITY ||
+                opcode == HCI_OPCODE_HCI_WRITE_INQUIRY_SCAN_ACTIVITY ||
+                opcode == HCI_OPCODE_HCI_WRITE_SCAN_ENABLE){
+                const uint8_t * params = hci_event_command_complete_get_return_parameters(packet);
+                printf("S31 Classic scan command 0x%04x status=%u\n", opcode, params[0]);
+            }
             s31_coex_command_complete(packet, size);
             break;
+        }
         case HCI_EVENT_PIN_CODE_REQUEST:
             // inform about legacy pairing with pin code - should only happen before Core v2.1
