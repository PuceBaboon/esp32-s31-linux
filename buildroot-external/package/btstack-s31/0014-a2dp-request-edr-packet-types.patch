From 43b18fa80e6cf70abfc1083c33f3b8d3539787a1 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Sat, 29 Aug 2026 01:05:00 +0800
Subject: [PATCH] a2dp: request and report the negotiated EDR packet types

Incoming BR/EDR links do not pass BTstack's create-connection packet mask to
the controller.  Explicitly request every packet type supported by both the
controller feature bitmap and the configured HCI ACL buffer, then report the
controller's packet-type-changed result.  This avoids silently running an A2DP
stream on one-slot basic-rate packets and provides direct coexistence evidence.
---
 example/a2dp_sink_demo.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 0c11a6f1..7798f619 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -906,1 +906,28 @@
+        case HCI_EVENT_CONNECTION_COMPLETE:
+            if (hci_event_connection_complete_get_status(packet) == ERROR_CODE_SUCCESS &&
+                hci_event_connection_complete_get_link_type(packet) == 1){
+                hci_con_handle_t handle =
+                    hci_event_connection_complete_get_connection_handle(packet);
+                uint16_t usable_packet_types = hci_usable_acl_packet_types();
+                uint16_t packet_types =
+                    ACL_PACKET_TYPES_DM1 |
+                    (usable_packet_types & (ACL_PACKET_TYPES_DM5 |
+                                             ACL_PACKET_TYPES_DH5 | 0x3000)) |
+                    ACL_PACKET_TYPES_2DH1 | ACL_PACKET_TYPES_3DH1 |
+                    ACL_PACKET_TYPES_2DH3 | ACL_PACKET_TYPES_3DH3;
+
+                printf("S31 BR/EDR link 0x%04x: usable ACL mask 0x%04x, "
+                       "requesting five-slot mask 0x%04x\n",
+                       handle, usable_packet_types, packet_types);
+                hci_send_cmd(&hci_change_connection_packet_type,
+                             handle, packet_types);
+            }
+            break;
+        case HCI_EVENT_CONNECTION_PACKET_TYPE_CHANGED:
+            printf("S31 BR/EDR packet type: handle=0x%04x status=0x%02x "
+                   "type=0x%04x\n",
+                   hci_event_connection_packet_type_changed_get_handle(packet),
+                   hci_event_connection_packet_type_changed_get_status(packet),
+                   hci_event_connection_packet_type_changed_get_packet_types(packet));
+            break;
         case HCI_EVENT_COMMAND_COMPLETE: {
