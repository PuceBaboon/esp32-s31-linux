From 0ed4ace91fe821c8186967e84cebf9f94649928b Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Sat, 29 Aug 2026 20:30:00 +0800
Subject: [PATCH] hci: batch controller-to-host ACL credits

Returning Host Number Of Completed Packets after every incoming ACL fragment
adds one HCI command and one shared-radio wakeup per fragment.  The S31
controller is configured with four host ACL buffers, so return credits in
matching groups.  A global pending counter avoids deadlock if fragments are
split over more than one connection.

Keep the upstream immediate-credit behaviour unless a port selects a batch.
---
 src/hci.c | 11 ++++++++++-
 src/hci.h |  3 +++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/hci.c b/src/hci.c
index f00634249..8c376a809 100644
--- a/src/hci.c
+++ b/src/hci.c
@@ -1254,5 +1254,12 @@ static void acl_handler(uint8_t *packet, uint16_t size){
 
 #ifdef ENABLE_HCI_CONTROLLER_TO_HOST_FLOW_CONTROL
-    hci_stack->host_completed_packets = 1;
+#ifdef S31_HCI_HOST_COMPLETED_BATCH
+    hci_stack->host_completed_packets_pending++;
+    if (hci_stack->host_completed_packets_pending >= S31_HCI_HOST_COMPLETED_BATCH){
+        hci_stack->host_completed_packets = 1;
+    }
+#else
+    hci_stack->host_completed_packets = 1;
+#endif
     conn->num_packets_completed++;
 #endif
@@ -6463,6 +6470,9 @@ static void hci_host_num_completed_packets(void){
     packet[2] = size - 3;
     packet[3] = num_handles;
 
+#ifdef S31_HCI_HOST_COMPLETED_BATCH
+    hci_stack->host_completed_packets_pending = 0;
+#endif
     hci_stack->host_completed_packets = 0;
 
     hci_dump_packet(HCI_COMMAND_DATA_PACKET, 0, packet, size);
diff --git a/src/hci.h b/src/hci.h
index 74c795427..3dd5cfac3 100644
--- a/src/hci.h
+++ b/src/hci.h
@@ -1291,5 +1291,8 @@ typedef struct {
 #ifdef ENABLE_HCI_CONTROLLER_TO_HOST_FLOW_CONTROL
     uint8_t   host_completed_packets;
+#ifdef S31_HCI_HOST_COMPLETED_BATCH
+    uint8_t   host_completed_packets_pending;
+#endif
 #endif
 
 #ifdef ENABLE_BLE
