From 4a8de7be2ee2b68e2d9a60d72dfde7d15088f99a Mon Sep 17 00:00:00 2001
From: S31 Linux <s31-linux@localhost>
Date: Thu, 27 Aug 2026 12:00:00 +0800
Subject: [PATCH] example: add low-overhead A2DP transport mode

The Linux port has no PCM audio backend in the S31 appliance image.  The
upstream demo nevertheless decodes every SBC packet and immediately discards
the PCM output when no backend is registered.  Make that diagnostic decode
optional and report compressed-media counters so the default transport-only
mode can still be verified without burning CPU on unused PCM.

Also allow the downstream build to cap SBC bitpool and codec capabilities.  A
constrained codec profile with a smaller bitpool reduces HCI traffic and
controller work on the memory- and CPU-constrained target.
---
 example/a2dp_sink_demo.c | 38 +++++++++++++++++++++++++++++++++++---
 1 file changed, 35 insertions(+), 3 deletions(-)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 6af9cfa7..676bbcdf 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -65,6 +65,7 @@
 #include <inttypes.h>
 #include <stdint.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 
 #include "btstack.h"
@@ -118,13 +119,29 @@ static uint8_t  sdp_avrcp_target_service_buffer[150];
 static uint8_t  sdp_avrcp_controller_service_buffer[200];
 static uint8_t  device_id_sdp_service_buffer[100];
 
-// we support all configurations with bitpool 2-53
+#ifndef S31_A2DP_SBC_MAX_BITPOOL
+#define S31_A2DP_SBC_MAX_BITPOOL 32
+#endif
+#ifndef S31_A2DP_SBC_CAPABILITIES_0
+#define S31_A2DP_SBC_CAPABILITIES_0 0x21
+#endif
+#ifndef S31_A2DP_SBC_CAPABILITIES_1
+#define S31_A2DP_SBC_CAPABILITIES_1 0x15
+#endif
+
+// Let the downstream build select the SBC quality/transport profile.
 static uint8_t media_sbc_codec_capabilities[] = {
-    0xFF,//(AVDTP_SBC_44100 << 4) | AVDTP_SBC_STEREO,
-    0xFF,//(AVDTP_SBC_BLOCK_LENGTH_16 << 4) | (AVDTP_SBC_SUBBANDS_8 << 2) | AVDTP_SBC_ALLOCATION_METHOD_LOUDNESS,
+    S31_A2DP_SBC_CAPABILITIES_0,
+    S31_A2DP_SBC_CAPABILITIES_1,
-    2, 53
+    2, S31_A2DP_SBC_MAX_BITPOOL
 };
 
+// With no PCM backend, decoding is diagnostic work rather than playback.
+// Set S31_BTSTACK_DECODE_SBC=1 to validate the full decoder path.
+static bool s31_decode_sbc;
+static uint32_t s31_media_packets;
+static uint64_t s31_media_bytes;
+
 // WAV File
 #ifdef STORE_TO_WAV_FILE
 static uint32_t audio_frame_count = 0;
@@ -367,6 +384,11 @@ static int setup_demo(void){
     hci_event_callback_registration.callback = &hci_packet_handler;
     hci_add_event_handler(&hci_event_callback_registration);
 
+    const char * decode_env = getenv("S31_BTSTACK_DECODE_SBC");
+    s31_decode_sbc = decode_env != NULL && strcmp(decode_env, "0") != 0;
+    printf("SBC decode: %s; max bitpool: %u\n",
+           s31_decode_sbc ? "enabled" : "transport-only", S31_A2DP_SBC_MAX_BITPOOL);
+
     // Inform about audio playback / test options
 #ifdef HAVE_POSIX_FILE_IO
     if (!btstack_audio_sink_get_instance()){
@@ -560,6 +582,9 @@ static void handle_l2cap_media_data_packet(uint8_t seid, uint8_t *packet, uint16
     int packet_length = size-pos;
     uint8_t *packet_begin = packet+pos;
 
+    s31_media_packets++;
+    s31_media_bytes += packet_length;
+
     const btstack_audio_sink_t * audio = btstack_audio_sink_get_instance();
     // process data right away if there's no audio implementation active, e.g. on posix systems to store as .wav
     if (!audio){
@@ -566,3 +591,5 @@ static void handle_l2cap_media_data_packet(uint8_t seid, uint8_t *packet, uint16
-        sbc_decoder_instance->decode_signed_16(&sbc_decoder_context, 0, packet_begin, packet_length);
+        if (s31_decode_sbc){
+            sbc_decoder_instance->decode_signed_16(&sbc_decoder_context, 0, packet_begin, packet_length);
+        }
         return;
     }
@@ -1152,6 +1179,8 @@ static void a2dp_sink_packet_handler(uint8_t packet_type, uint16_t channel, uint
 #endif
         case A2DP_SUBEVENT_STREAM_STARTED:
             printf("A2DP  Sink      : Stream started\n");
+            s31_media_packets = 0;
+            s31_media_bytes = 0;
             a2dp_conn->stream_state = STREAM_STATE_PLAYING;
             if (a2dp_conn->sbc_configuration.reconfigure){
                 media_processing_close();
@@ -1163,6 +1193,8 @@ static void a2dp_sink_packet_handler(uint8_t packet_type, uint16_t channel, uint
         
         case A2DP_SUBEVENT_STREAM_SUSPENDED:
             printf("A2DP  Sink      : Stream paused\n");
+            printf("A2DP  Sink      : Received %" PRIu32 " media packets, %" PRIu64 " SBC bytes\n",
+                   s31_media_packets, s31_media_bytes);
             a2dp_conn->stream_state = STREAM_STATE_PAUSED;
             media_processing_pause();
             break;
-- 
