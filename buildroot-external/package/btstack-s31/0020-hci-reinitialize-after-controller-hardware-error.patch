From: ESP32-S31 Linux <s31-linux@example.invalid>
Subject: [PATCH] hci: restart initialization after controller hardware error

Suspend restarts the S31 controller and invalidates all connection handles.
The default error handler only reopened the transport, leaving HCI_STATE_OFF
and stale host connections. Discard those connections and use the public
power-on path to send Reset and replay controller configuration.

--- a/src/hci.c
+++ b/src/hci.c
@@ -209,6 +209,7 @@
 static int  hci_power_control_on(void);
 static void hci_power_control_off(void);
 static void hci_state_reset(void);
+static void hci_discard_connections(void);
 static void hci_halting_timeout_handler(btstack_timer_source_t * ds);
 static void hci_schedule_transport_packet_sent(void);
 static void hci_emit_disconnection_complete(hci_con_handle_t con_handle, uint8_t reason);
@@ -4466,9 +4467,13 @@
     if (hci_stack->hardware_error_callback){
         (*hci_stack->hardware_error_callback)(packet[2]);
     } else {
-        // if no special requests, just reboot stack
+        // Controller handles are no longer valid. Restart the HCI state machine.
         hci_power_control_off();
-        hci_power_control_on();
+        hci_discard_connections();
+#if defined(ENABLE_BLE) && defined(ENABLE_LE_PERIPHERAL)
+        hci_update_advertisements_enabled_for_current_roles();
+#endif
+        hci_power_control(HCI_POWER_ON);
     }
 }
 
