From 5c15fa3be31c0d8237f36fa7efc3e157cabd9e82 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Fri, 28 Aug 2026 16:00:00 +0800
Subject: [PATCH] a2dp: match Bluedroid classic scan duty cycle

ESP-IDF Bluedroid explicitly programs the Bluetooth Core default page and
inquiry scan intervals and windows.  BTstack's A2DP demo only enables
discoverability and otherwise inherits controller state, which can leave an
already-enabled integrated controller scanning at excessive duty cycle across
userspace restarts.

Program the same low-duty defaults after HCI reaches WORKING.  BTstack resets
the pending GAP task bitmap during controller initialization, so calls made by
setup_demo() are otherwise discarded before they can reach the controller.
This keeps an associated Wi-Fi station usable while the sink remains pairable.
---
 example/a2dp_sink_demo.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 9c90d2d74..692980190 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -852,6 +852,14 @@ static void hci_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *
 
     bd_addr_t address;
     switch (hci_event_packet_get_type(packet)){
+        case BTSTACK_EVENT_STATE:
+            if (btstack_event_state_get_state(packet) == HCI_STATE_WORKING){
+                // Match ESP-IDF Bluedroid defaults after BTstack's HCI reset.
+                // Earlier calls are erased by hci_state_reset().
+                gap_set_page_scan_activity(0x0800, 0x0012);
+                gap_inquiry_set_scan_activity(0x1000, 0x0012);
+            }
+            break;
         case HCI_EVENT_COMMAND_COMPLETE:
             s31_coex_command_complete(packet, size);
             break;
