From 1e355024571124476539366b428d54829fcc90cc Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Thu, 27 Aug 2026 17:00:00 +0800
Subject: [PATCH] linux: drain queued HCI packets per run-loop wakeup

The S31 radio bridge deliberately publishes several ACL packets together on
each periodic pass.  Reading only one packet makes the POSIX run loop return to
poll for every packet in that batch.  Drain up to eight queued packets while
the non-blocking HCI socket remains readable.  The bound preserves run-loop
fairness if a controller produces traffic continuously.
---
 platform/linux/hci_transport_linux.c | 23 +++++++++++++++++------
 1 file changed, 17 insertions(+), 6 deletions(-)

diff --git a/platform/linux/hci_transport_linux.c b/platform/linux/hci_transport_linux.c
index f9706bbb2..438fa09b7 100644
--- a/platform/linux/hci_transport_linux.c
+++ b/platform/linux/hci_transport_linux.c
@@ -43,6 +43,7 @@
 #include "hci.h"
 
 #include <err.h>
+#include <errno.h>
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -108,14 +109,25 @@ static const hci_transport_config_linux_t * hci_transport_config_linux;
 
 static void hci_transport_linux_process_read(btstack_data_source_t * ds) {
     UNUSED(ds);
+    int packets;
 
-    int bytes_read = read(hci_socket, hci_packet, HCI_INCOMING_PACKET_BUFFER_SIZE);
-    if (bytes_read < 0) {
-        perror("Failed to read HCI packet");
-        return;
-    }
+    for (packets = 0; packets < 8; packets++) {
+        int bytes_read = read(hci_socket, hci_packet,
+                              HCI_INCOMING_PACKET_BUFFER_SIZE);
+        if (bytes_read < 0) {
+            if (errno == EAGAIN || errno == EWOULDBLOCK) {
+                return;
+            }
+            perror("Failed to read HCI packet");
+            return;
+        }
+        if (bytes_read == 0) {
+            return;
+        }
 
-    hci_transport_linux_packet_handler(hci_packet[0], &hci_packet[1], bytes_read-1);
+        hci_transport_linux_packet_handler(hci_packet[0], &hci_packet[1],
+                                           bytes_read - 1);
+    }
 }
 
 static void hci_transport_linux_process(btstack_data_source_t *ds, btstack_data_source_callback_type_t callback_type) {
