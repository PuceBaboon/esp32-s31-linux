From 54334f9dbf64badc9fb7bfb449597181ea866157 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Thu, 27 Aug 2026 18:30:00 +0800
Subject: [PATCH] example: compile out the unused PCM playback path

The S31 appliance consumes the compressed A2DP stream for transport testing
and has no PCM backend.  Runtime suppression still retained the Bluedroid SBC
decoder and large PCM/SBC staging buffers.  Make transport-only a compile-time
profile so section garbage collection can remove that code and data entirely.
---
 example/a2dp_sink_demo.c | 34 ++++++++++++++++++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 676bbcdf..783fef025 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -125,6 +125,9 @@ static uint8_t  device_id_sdp_service_buffer[100];
 #ifndef S31_A2DP_SBC_CAPABILITIES_1
 #define S31_A2DP_SBC_CAPABILITIES_1 0x15
 #endif
+#ifndef S31_BTSTACK_TRANSPORT_ONLY
+#define S31_BTSTACK_TRANSPORT_ONLY 0
+#endif
 
 // Let the downstream build select the SBC quality/transport profile.
 static uint8_t media_sbc_codec_capabilities[] = {
@@ -136,10 +139,12 @@ static uint8_t media_sbc_codec_capabilities[] = {
 
 // With no PCM backend, decoding is diagnostic work rather than playback.
 // Set S31_BTSTACK_DECODE_SBC=1 to validate the full decoder path.
+#if !S31_BTSTACK_TRANSPORT_ONLY
 static bool s31_decode_sbc;
+#endif
 static uint32_t s31_media_packets;
 static uint64_t s31_media_bytes;
 
 // WAV File
 #ifdef STORE_TO_WAV_FILE
 static uint32_t audio_frame_count = 0;
@@ -381,10 +387,15 @@ static int setup_demo(void){
     hci_event_callback_registration.callback = &hci_packet_handler;
     hci_add_event_handler(&hci_event_callback_registration);
 
+#if S31_BTSTACK_TRANSPORT_ONLY
+    printf("SBC decode: compiled out; max bitpool: %u\n",
+           S31_A2DP_SBC_MAX_BITPOOL);
+#else
     const char * decode_env = getenv("S31_BTSTACK_DECODE_SBC");
     s31_decode_sbc = decode_env != NULL && strcmp(decode_env, "0") != 0;
     printf("SBC decode: %s; max bitpool: %u\n",
            s31_decode_sbc ? "enabled" : "transport-only", S31_A2DP_SBC_MAX_BITPOOL);
+#endif
 
     // Inform about audio playback / test options
 #ifdef HAVE_POSIX_FILE_IO
@@ -408,6 +418,7 @@ static int setup_demo(void){
 /* LISTING_END */
 
 
+#if !S31_BTSTACK_TRANSPORT_ONLY
 static void playback_handler(int16_t * buffer, uint16_t num_audio_frames, const btstack_audio_context_t * context){
     UNUSED(context);
 
@@ -557,6 +568,15 @@ static void media_processing_close(void){
         audio->close();
     }
 }
+#else
+static int media_processing_init(media_codec_configuration_sbc_t * configuration){
+    UNUSED(configuration);
+    return 0;
+}
+static void media_processing_start(void){}
+static void media_processing_pause(void){}
+static void media_processing_close(void){}
+#endif
 
 /* @section Handle Media Data Packet 
  *
@@ -581,6 +601,11 @@ static void handle_l2cap_media_data_packet(uint8_t seid, uint8_t *packet, uint16
     s31_media_packets++;
     s31_media_bytes += packet_length;
 
+#if S31_BTSTACK_TRANSPORT_ONLY
+    UNUSED(packet_begin);
+    UNUSED(sbc_header);
+    return;
+#else
     const btstack_audio_sink_t * audio = btstack_audio_sink_get_instance();
     // process data right away if there's no audio implementation active, e.g. on posix systems to store as .wav
     if (!audio){
@@ -640,5 +665,6 @@ static void handle_l2cap_media_data_packet(uint8_t seid, uint8_t *packet, uint16
         media_processing_start();
     }
+#endif
 }
 
 static int read_sbc_header(uint8_t * packet, int size, int * offset, avdtp_sbc_codec_header_t * sbc_header){
-- 
2.43.0
