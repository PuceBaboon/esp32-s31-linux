From 684a33b163b2c60bfb1affc263704e628666062f Mon Sep 17 00:00:00 2001
From: S31 Linux <s31-linux@localhost>
Date: Wed, 26 Aug 2026 12:00:00 +0800
Subject: [PATCH] linux: allow no packet log and persist TLV database

Avoid serializing every HCI packet when --logfile none is selected and keep
Classic link keys on the persistent overlay instead of volatile /tmp.
---
 port/linux/main.c | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/port/linux/main.c b/port/linux/main.c
index 12860843..092a9106 100644
--- a/port/linux/main.c
+++ b/port/linux/main.c
@@ -70,7 +70,7 @@ static hci_transport_config_linux_t transport_config = {
     .device_id = 0,
 };
 
-#define TLV_DB_PATH_PREFIX "/tmp/btstack_"
+#define TLV_DB_PATH_PREFIX "/var/lib/btstack/btstack_"
 #define TLV_DB_PATH_POSTFIX ".tlv"
 static char tlv_db_path[100];
 static bool tlv_reset;
@@ -251,11 +251,15 @@ int main(int argc, const char * argv[]){
 
         log_file_path = pklg_path;
     }
-    hci_dump_posix_fs_open(log_file_path, HCI_DUMP_PACKETLOGGER);
-    const hci_dump_t * hci_dump_impl = hci_dump_posix_fs_get_instance();
-    hci_dump_init(hci_dump_impl);
-    printf("Packet Log: %s\n", log_file_path);
-    printf("Bluetooth device: hci%u\n", transport_config.device_id);
+    if (strcmp(log_file_path, "none") != 0){
+        hci_dump_posix_fs_open(log_file_path, HCI_DUMP_PACKETLOGGER);
+        const hci_dump_t * hci_dump_impl = hci_dump_posix_fs_get_instance();
+        hci_dump_init(hci_dump_impl);
+        printf("Packet Log: %s\n", log_file_path);
+    } else {
+        printf("Packet Log: disabled\n");
+    }
+    printf("Bluetooth device: hci%u\n", transport_config.device_id);
 
     // init HCI
 	const hci_transport_t * transport = hci_transport_linux_instance();
-- 
2.43.0
