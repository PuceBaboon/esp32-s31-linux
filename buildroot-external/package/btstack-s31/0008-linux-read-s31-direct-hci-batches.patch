From d78bcfe6a558a41e7fd220b4cae0db2e2bdd23a0 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Thu, 27 Aug 2026 19:00:00 +0800
Subject: [PATCH] linux: read queued S31 HCI frames in one syscall

The S31 direct endpoint returns up to eight queued H4 frames as little-endian
length-prefixed records when userspace supplies a buffer larger than one HCI
frame. Decode that private batch ABI while retaining BTstack's incoming
pre-buffer contract.
---
 platform/linux/hci_transport_linux.c | 42 +++++++++++++++++++++++-------------
 1 file changed, 30 insertions(+), 12 deletions(-)

diff --git a/platform/linux/hci_transport_linux.c b/platform/linux/hci_transport_linux.c
index ce4383e76..4ea2080ae 100644
--- a/platform/linux/hci_transport_linux.c
+++ b/platform/linux/hci_transport_linux.c
@@ -69,6 +69,10 @@ static btstack_data_source_t hci_transport_linux_data_source;
 static uint8_t hci_packet_with_pre_buffer[HCI_INCOMING_PRE_BUFFER_SIZE + HCI_INCOMING_PACKET_BUFFER_SIZE + 1]; // packet type + max(acl header + acl payload, event header + event data)
 static uint8_t * hci_packet = &hci_packet_with_pre_buffer[HCI_INCOMING_PRE_BUFFER_SIZE];
 
+#define S31_HCI_BATCH_PACKETS 8
+#define S31_HCI_BATCH_RECORD_SIZE (2 + HCI_INCOMING_PACKET_BUFFER_SIZE + 1)
+static uint8_t s31_hci_batch[S31_HCI_BATCH_PACKETS * S31_HCI_BATCH_RECORD_SIZE];
+
 // linux hci socket
 static int hci_socket = -1;
 
@@ -77,23 +81,37 @@ static const hci_transport_config_linux_t * hci_transport_config_linux;
 static void hci_transport_linux_process_read(btstack_data_source_t * ds) {
     UNUSED(ds);
     int packets;
+    size_t offset = 0;
 
-    for (packets = 0; packets < 8; packets++) {
-        int bytes_read = read(hci_socket, hci_packet,
-                              HCI_INCOMING_PACKET_BUFFER_SIZE);
-        if (bytes_read < 0) {
-            if (errno == EAGAIN || errno == EWOULDBLOCK) {
-                return;
-            }
-            perror("Failed to read HCI packet");
-            return;
-        }
-        if (bytes_read == 0) {
+    int bytes_read = read(hci_socket, s31_hci_batch, sizeof(s31_hci_batch));
+    if (bytes_read < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
             return;
         }
+        perror("Failed to read HCI packet batch");
+        return;
+    }
+    if (bytes_read == 0) {
+        return;
+    }
 
+    for (packets = 0; packets < S31_HCI_BATCH_PACKETS && offset < (size_t) bytes_read; packets++) {
+        uint16_t frame_size;
+        if ((size_t) bytes_read - offset < 2) {
+            log_error("Truncated S31 HCI batch header");
+            return;
+        }
+        frame_size = s31_hci_batch[offset] | (((uint16_t) s31_hci_batch[offset + 1]) << 8);
+        offset += 2;
+        if (frame_size == 0 || frame_size > HCI_INCOMING_PACKET_BUFFER_SIZE + 1 ||
+            frame_size > (size_t) bytes_read - offset) {
+            log_error("Invalid S31 HCI batch record size %u", frame_size);
+            return;
+        }
+        memcpy(hci_packet, &s31_hci_batch[offset], frame_size);
+        offset += frame_size;
         hci_transport_linux_packet_handler(hci_packet[0], &hci_packet[1],
-                                           bytes_read - 1);
+                                           frame_size - 1);
     }
 }
 
