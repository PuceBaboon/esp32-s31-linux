From e58792bf7521827a0c350e4de7794e91ec28d162 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Thu, 27 Aug 2026 18:00:00 +0800
Subject: [PATCH] linux: use only the S31 direct H4 endpoint

The S31 appliance does not use the generic Bluetooth socket fallback. Require
its direct character device so userspace has one unambiguous controller owner.
---
 platform/linux/hci_transport_linux.c | 25 ++++++++++---------------
 1 file changed, 10 insertions(+), 15 deletions(-)

diff --git a/platform/linux/hci_transport_linux.c b/platform/linux/hci_transport_linux.c
index 438fa09b7..df781460e 100644
--- a/platform/linux/hci_transport_linux.c
+++ b/platform/linux/hci_transport_linux.c
@@ -43,6 +43,7 @@
 #include "hci.h"
 
 #include <err.h>
+#include <fcntl.h>
 #include <errno.h>
 #include <stdint.h>
 #include <stdio.h>
@@ -153,23 +154,17 @@ static void hci_transport_linux_init (const void *transport_config){
 }
 
 static int hci_transport_linux_open(void) {
-    struct sockaddr_hci addr;
-
-    hci_socket = socket(AF_BLUETOOTH, SOCK_RAW | SOCK_CLOEXEC | SOCK_NONBLOCK, BTPROTO_HCI);
+    const char * direct_device = getenv("S31_HCI_DEVICE");
+    if (direct_device == NULL || direct_device[0] == '\0') {
+        fprintf(stderr, "S31_HCI_DEVICE is not set\n");
+        return -1;
+    }
+    hci_socket = open(direct_device, O_RDWR | O_CLOEXEC | O_NONBLOCK);
     if (hci_socket < 0) {
-        perror("Failed to create HCI socket");
+        perror("Failed to open direct HCI device");
         return -1;
     }
-
-    memset(&addr, 0, sizeof(addr));
-    addr.hci_family = AF_BLUETOOTH;
-    addr.hci_dev = hci_transport_config_linux->device_id;
-    addr.hci_channel = HCI_CHANNEL_USER;
-    if (bind(hci_socket, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
-        perror("Failed to bind HCI socket");
-        close(hci_socket);
-        return -1;
-    }
+    log_info("Using direct HCI device %s", direct_device);
 
     // set up data_source
     btstack_run_loop_set_data_source_fd(&hci_transport_linux_data_source, hci_socket);
@@ -209,7 +204,7 @@ static int hci_transport_linux_send_packet(uint8_t packet_type, uint8_t * packet
 }
 
 static const hci_transport_t hci_transport_linux = {
-    .name = "Linux BlueZ",
+    .name = "ESP32-S31 direct H4",
     .init = &hci_transport_linux_init,
     .open = &hci_transport_linux_open,
     .close = &hci_transport_linux_close,
-- 
