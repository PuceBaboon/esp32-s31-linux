From d5e75aebc65bf885e2d7f8fbe9888a11ce1f6001 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Fri, 28 Aug 2026 18:00:00 +0800
Subject: [PATCH] a2dp: allow pairability diagnostic toggle

Keep the A2DP sink pairable by default, but allow a bounded coexistence
diagnostic to disable both Classic page and inquiry scan after HCI reaches
WORKING.  This uses the standard Write Scan Enable path and does not alter
controller capabilities or coexistence policy.

The environment switch is intentionally runtime-only so the same binary can
separate controller-enabled operation from pairable scan duty without another
firmware build.
---
 example/a2dp_sink_demo.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 40ecdd9d1..cc72cb19f 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -851,6 +851,15 @@ static void hci_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *
                 // Earlier calls are erased by hci_state_reset().
                 gap_set_page_scan_activity(0x0800, 0x0012);
                 gap_inquiry_set_scan_activity(0x1000, 0x0012);
+                const char * pairable_env = getenv("S31_BTSTACK_PAIRABLE");
+                bool pairable = pairable_env == NULL ||
+                                strcmp(pairable_env, "0") != 0;
+                if (!pairable){
+                    gap_discoverable_control(0);
+                    gap_connectable_control(0);
+                }
+                printf("S31 Classic pairability: %s\n",
+                       pairable ? "enabled" : "disabled");
             }
             break;
         case HCI_EVENT_COMMAND_COMPLETE: {
