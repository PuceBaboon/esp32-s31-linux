From 7d83ce52a10a836dc2f8d930555f7c0aeead1a9c Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Fri, 28 Aug 2026 14:00:00 +0800
Subject: [PATCH] a2dp: mirror IDF coexist status transitions

ESP-IDF Bluedroid sends the ESP common coexistence vendor command at A2DP
stream start and stop.  Use the same 0xfc82 command and the same two-step
status update when the S31 combined Wi-Fi/Bluetooth profile enables it.

Serialize the two commands through BTstack's command-credit path and require
successful Command Complete acknowledgements.  A controller rejection
disables further coexistence commands instead of inventing compatibility.
---
 example/a2dp_sink_demo.c | 122 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 122 insertions(+)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 54ed85a91..9c90d2d74 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -149,5 +149,31 @@ static uint32_t s31_media_packets;
 static uint64_t s31_media_bytes;
 
+#define S31_ESP_COEX_STATUS_OPCODE 0xfc82
+#define S31_ESP_COEX_TYPE_BT       2
+#define S31_ESP_COEX_OP_CLEAR      0
+#define S31_ESP_COEX_OP_SET        1
+#define S31_ESP_COEX_A2DP_STREAMING 0x10
+#define S31_ESP_COEX_A2DP_PAUSED    0x20
+
+static const hci_cmd_t s31_esp_coex_status_cmd = {
+    S31_ESP_COEX_STATUS_OPCODE, "111"
+};
+
+typedef enum {
+    S31_COEX_IDLE,
+    S31_COEX_SEND_STREAMING,
+    S31_COEX_WAIT_STREAMING,
+    S31_COEX_SEND_PAUSED,
+    S31_COEX_WAIT_PAUSED,
+} s31_coex_phase_t;
+
+static bool s31_coex_enabled;
+static bool s31_coex_supported = true;
+static bool s31_coex_desired_streaming;
+static bool s31_coex_applied_streaming;
+static bool s31_coex_transition_streaming;
+static s31_coex_phase_t s31_coex_phase;
+
 // WAV File
 #ifdef STORE_TO_WAV_FILE
 static uint32_t audio_frame_count = 0;
@@ -399,6 +425,11 @@ static int setup_demo(void){
     hci_event_callback_registration.callback = &hci_packet_handler;
     hci_add_event_handler(&hci_event_callback_registration);
 
+    const char * coex_env = getenv("S31_BTSTACK_COEX");
+    s31_coex_enabled = coex_env != NULL && strcmp(coex_env, "0") != 0;
+    printf("ESP-IDF A2DP coexistence status: %s\n",
+           s31_coex_enabled ? "enabled" : "disabled");
+
 #if S31_BTSTACK_TRANSPORT_ONLY
     printf("SBC decode: compiled out; max bitpool: %u\n",
            S31_A2DP_SBC_MAX_BITPOOL);
@@ -727,13 +758,97 @@ static void dump_sbc_configuration(media_codec_configuration_sbc_t * configurati
     printf("\n");
 }
 
+static void s31_coex_pump(void){
+    uint8_t op;
+    uint8_t status;
+
+    if (!s31_coex_enabled || !s31_coex_supported) return;
+
+    if (s31_coex_phase == S31_COEX_IDLE){
+        if (s31_coex_desired_streaming == s31_coex_applied_streaming) return;
+        s31_coex_transition_streaming = s31_coex_desired_streaming;
+        s31_coex_phase = S31_COEX_SEND_STREAMING;
+    }
+    if (!hci_can_send_command_packet_now()) return;
+
+    switch (s31_coex_phase){
+        case S31_COEX_SEND_STREAMING:
+            op = s31_coex_transition_streaming ?
+                S31_ESP_COEX_OP_SET : S31_ESP_COEX_OP_CLEAR;
+            status = hci_send_cmd(&s31_esp_coex_status_cmd,
+                                  S31_ESP_COEX_TYPE_BT, op,
+                                  S31_ESP_COEX_A2DP_STREAMING);
+            if (status == ERROR_CODE_SUCCESS){
+                s31_coex_phase = S31_COEX_WAIT_STREAMING;
+            }
+            break;
+        case S31_COEX_SEND_PAUSED:
+            status = hci_send_cmd(&s31_esp_coex_status_cmd,
+                                  S31_ESP_COEX_TYPE_BT,
+                                  S31_ESP_COEX_OP_CLEAR,
+                                  S31_ESP_COEX_A2DP_PAUSED);
+            if (status == ERROR_CODE_SUCCESS){
+                s31_coex_phase = S31_COEX_WAIT_PAUSED;
+            }
+            break;
+        default:
+            break;
+    }
+}
+
+static void s31_coex_request(bool streaming){
+    if (!s31_coex_enabled || !s31_coex_supported) return;
+    s31_coex_desired_streaming = streaming;
+    s31_coex_pump();
+}
+
+static void s31_coex_command_complete(uint8_t *packet, uint16_t size){
+    uint8_t status;
+    const char *step;
+
+    if (!s31_coex_enabled || size < 6) return;
+    if (hci_event_command_complete_get_command_opcode(packet) !=
+        S31_ESP_COEX_STATUS_OPCODE) return;
+
+    status = hci_event_command_complete_get_return_parameters(packet)[0];
+    if (s31_coex_phase == S31_COEX_WAIT_STREAMING){
+        step = "streaming";
+    } else if (s31_coex_phase == S31_COEX_WAIT_PAUSED){
+        step = "paused-clear";
+    } else {
+        printf("S31 coexistence: unexpected 0xfc82 completion status 0x%02x\n",
+               status);
+        return;
+    }
+    printf("S31 coexistence: 0xfc82 %s acknowledgement status 0x%02x\n",
+           step, status);
+    if (status != ERROR_CODE_SUCCESS){
+        s31_coex_supported = false;
+        s31_coex_phase = S31_COEX_IDLE;
+        printf("S31 coexistence: controller rejected 0xfc82; updates disabled\n");
+        return;
+    }
+
+    if (s31_coex_phase == S31_COEX_WAIT_STREAMING){
+        s31_coex_phase = S31_COEX_SEND_PAUSED;
+    } else {
+        s31_coex_applied_streaming = s31_coex_transition_streaming;
+        s31_coex_phase = S31_COEX_IDLE;
+        printf("S31 coexistence: A2DP state %s\n",
+               s31_coex_applied_streaming ? "streaming" : "stopped");
+    }
+    s31_coex_pump();
+}
+
 static void hci_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *packet, uint16_t size){
     UNUSED(channel);
-    UNUSED(size);
     if (packet_type != HCI_EVENT_PACKET) return;
 
     bd_addr_t address;
     switch (hci_event_packet_get_type(packet)){
+        case HCI_EVENT_COMMAND_COMPLETE:
+            s31_coex_command_complete(packet, size);
+            break;
         case HCI_EVENT_PIN_CODE_REQUEST:
             // inform about legacy pairing with pin code - should only happen before Core v2.1
             printf("Pin code request for Legacy Pairing received -> abort pairing'\n");
@@ -743,6 +858,7 @@ static void hci_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *pa
         default:
             break;
     }
+    s31_coex_pump();
 }
 
 #ifdef ENABLE_AVRCP_COVER_ART
@@ -1209,4 +1325,5 @@ static void a2dp_sink_packet_handler(uint8_t packet_type, uint16_t channel, uint8
             printf("A2DP  Sink      : Stream started\n");
             s31_media_packets = 0;
+            s31_coex_request(true);
             s31_media_bytes = 0;
             a2dp_conn->stream_state = STREAM_STATE_PLAYING;
@@ -1223,4 +1340,5 @@ static void a2dp_sink_packet_handler(uint8_t packet_type, uint16_t channel, uint8
                    s31_media_packets, s31_media_bytes);
             a2dp_conn->stream_state = STREAM_STATE_PAUSED;
+            s31_coex_request(false);
             media_processing_pause();
             break;
@@ -1230,4 +1348,5 @@ static void a2dp_sink_packet_handler(uint8_t packet_type, uint16_t channel, uint8
             printf("A2DP  Sink      : Stream released\n");
             a2dp_conn->stream_state = STREAM_STATE_CLOSED;
+            s31_coex_request(false);
             media_processing_close();
             break;
@@ -1234,7 +1353,8 @@ static void a2dp_sink_packet_handler(uint8_t packet_type, uint16_t channel, uint8
             printf("A2DP  Sink      : Signaling connection released\n");
             a2dp_conn->a2dp_cid = 0;
+            s31_coex_request(false);
             media_processing_close();
             break;
         
         default:
             break;
-- 
