From e8d2296099f8de90ecbd22d4e22332d5ce95da97 Mon Sep 17 00:00:00 2001
From: S31 Linux <s31-linux@localhost>
Date: Sun, 30 Aug 2026 16:15:00 +0800
Subject: [PATCH] a2dp: pump coexist status on media traffic

An A2DP start event can arrive while BTstack has no HCI command credit.  The
coexist state machine then remains in its send phase because the steady media
path does not necessarily deliver another HCI event to the application.

Retry the pending state transition from the media receive path.  Once both IDF
coexist status commands are acknowledged, the pump reduces to two boolean
checks per packet.
---
 example/a2dp_sink_demo.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 2b237ece..85355051 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -177,6 +177,8 @@ static bool s31_coex_applied_streaming;
 static bool s31_coex_transition_streaming;
 static s31_coex_phase_t s31_coex_phase;
 
+static void s31_coex_pump(void);
+
 // WAV File
 #ifdef STORE_TO_WAV_FILE
 static uint32_t audio_frame_count = 0;
@@ -714,6 +716,7 @@ static void handle_l2cap_media_data_packet(uint8_t seid, uint8_t *packet, uint16
     s31_media_packets++;
     s31_media_bytes += packet_length;
     s31_media_track_sequence(media_header.sequence_number);
+    s31_coex_pump();
     if ((s31_media_packets & 0x7ff) == 0){
         s31_media_report();
     }
