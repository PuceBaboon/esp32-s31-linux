From 8f3d6ec489e23a16a33b1fa8346a1f8c1abe1171 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Sat, 29 Aug 2026 18:00:00 +0800
Subject: [PATCH] hci: allow ACL-only controller-to-host flow control

ESP-IDF's Bluedroid host enables ACL controller-to-host flow control and
advertises SCO buffers separately.  The S31 direct-HCI appliance has no SCO
consumer, so requesting combined ACL+SCO flow control with zero SCO buffers
stalls incoming ACL delivery in the controller.

Keep the upstream default for other ports and let the S31 configuration select
the same ACL-only mode used by Bluedroid.
---
 src/hci.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/hci.c b/src/hci.c
index 6fdc536e4..f00634249 100644
--- a/src/hci.c
+++ b/src/hci.c
@@ -2156,7 +2156,11 @@ static void hci_initializing_run(void){
 #ifdef ENABLE_HCI_CONTROLLER_TO_HOST_FLOW_CONTROL
         case HCI_INIT_SET_CONTROLLER_TO_HOST_FLOW_CONTROL:
             hci_stack->substate = HCI_INIT_W4_SET_CONTROLLER_TO_HOST_FLOW_CONTROL;
+#ifdef S31_HCI_ACL_ONLY_FLOW_CONTROL
+            hci_send_cmd(&hci_set_controller_to_host_flow_control, 1);  // ACL Flow Control
+#else
             hci_send_cmd(&hci_set_controller_to_host_flow_control, 3);  // ACL + SCO Flow Control
+#endif
             break;
         case HCI_INIT_HOST_BUFFER_SIZE:
             hci_stack->substate = HCI_INIT_W4_HOST_BUFFER_SIZE;
-- 
