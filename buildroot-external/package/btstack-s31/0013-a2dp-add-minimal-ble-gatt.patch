From 1c937926888479f83bf587aecac4b49d32ecf787 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Fri, 28 Aug 2026 23:30:00 +0800
Subject: [PATCH] a2dp: add a minimal BLE GAP/GATT peripheral

Keep BLE ownership in the same BTstack process as the BR/EDR A2DP sink.  The
small runtime database exposes the standard GAP/GATT services and a read-only
test service, while connectable advertising provides an end-to-end BLE host
test without adding BlueZ or a second HCI owner.
---
 example/a2dp_sink_demo.c | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 676bbcdf..0c11a6f1 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -263,5 +263,44 @@ static void stdin_process(char cmd);
 #endif
 
+#ifdef ENABLE_BLE
+static const uint8_t s31_ble_name[] = "S31 Radio";
+static const uint8_t s31_ble_value[] = "ready";
+static const uint8_t s31_ble_adv_data[] = {
+    0x02, BLUETOOTH_DATA_TYPE_FLAGS, 0x06,
+    0x05, BLUETOOTH_DATA_TYPE_COMPLETE_LIST_OF_16_BIT_SERVICE_CLASS_UUIDS,
+          0x00, 0x18, 0x10, 0xff,
+    0x0a, BLUETOOTH_DATA_TYPE_COMPLETE_LOCAL_NAME,
+          'S', '3', '1', ' ', 'R', 'a', 'd', 'i', 'o',
+};
+
+static void s31_ble_setup(void){
+    bd_addr_t null_addr = { 0 };
+
+    sm_set_io_capabilities(IO_CAPABILITY_NO_INPUT_NO_OUTPUT);
+    sm_set_authentication_requirements(0);
+
+    att_db_util_init();
+    att_db_util_add_service_uuid16(ORG_BLUETOOTH_SERVICE_GENERIC_ACCESS);
+    att_db_util_add_characteristic_uuid16(
+        ORG_BLUETOOTH_CHARACTERISTIC_GAP_DEVICE_NAME,
+        ATT_PROPERTY_READ, ATT_SECURITY_NONE, ATT_SECURITY_NONE,
+        (uint8_t *) s31_ble_name, sizeof(s31_ble_name) - 1u);
+    att_db_util_add_service_uuid16(ORG_BLUETOOTH_SERVICE_GENERIC_ATTRIBUTE);
+    att_db_util_add_service_uuid16(0xff10);
+    att_db_util_add_characteristic_uuid16(
+        0xff11, ATT_PROPERTY_READ, ATT_SECURITY_NONE, ATT_SECURITY_NONE,
+        (uint8_t *) s31_ble_value, sizeof(s31_ble_value) - 1u);
+    att_server_init(att_db_util_get_address(), NULL, NULL);
+
+    gap_advertisements_set_params(0x00a0, 0x00a0, 0, 0, null_addr,
+                                  0x07, 0x00);
+    gap_advertisements_set_data(sizeof(s31_ble_adv_data),
+                                (uint8_t *) s31_ble_adv_data);
+    gap_advertisements_enable(1);
+    printf("BLE GAP/GATT: advertising as S31 Radio, service 0xff10\n");
+}
+#endif
+
 static int setup_demo(void){
 
     // init protocols
@@ -272,5 +311,6 @@ static int setup_demo(void){
     // Initialize LE Security Manager. Needed for cross-transport key derivation
     sm_init();
+    s31_ble_setup();
 #endif
 #ifdef ENABLE_AVRCP_COVER_ART
     goep_client_init();
-- 
