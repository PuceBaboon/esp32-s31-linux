From 6dc78f7f24a2746af311e4f94742140f55e8ee61 Mon Sep 17 00:00:00 2001
From: S31 Linux <s31-linux@localhost>
Date: Sun, 30 Aug 2026 15:10:00 +0800
Subject: [PATCH] example: report A2DP media sequence loss

The transport-only sink has no PCM queue that can overrun.  Detect ingress
loss instead by tracking the RTP sequence number carried by every AVDTP media
packet.  Report forward gaps, duplicates and reordered packets alongside the
existing packet/byte counters.  A periodic 2048-packet report allows a live
coexistence stress test to inspect the stream without suspending it.
---
 example/a2dp_sink_demo.c | 51 ++++++++++++++++++++++++++++++++++++++---
 1 file changed, 48 insertions(+), 3 deletions(-)

diff --git a/example/a2dp_sink_demo.c b/example/a2dp_sink_demo.c
index 9b7e1c75..2b237ece 100644
--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -146,6 +146,11 @@ static bool s31_decode_sbc;
 #endif
 static uint32_t s31_media_packets;
 static uint64_t s31_media_bytes;
+static bool s31_media_sequence_valid;
+static uint16_t s31_media_last_sequence;
+static uint32_t s31_media_sequence_gaps;
+static uint32_t s31_media_duplicate_packets;
+static uint32_t s31_media_reordered_packets;
 
 #define S31_ESP_COEX_STATUS_OPCODE 0xfc82
 #define S31_ESP_COEX_TYPE_BT       2
@@ -660,5 +665,37 @@ static int read_media_data_header(uint8_t * packet, int size, int * offset, avdt
 static int read_sbc_header(uint8_t * packet, int size, int * offset, avdtp_sbc_codec_header_t * sbc_header);
 
+static void s31_media_report(void){
+    printf("A2DP  Sink      : Received %" PRIu32 " media packets, %" PRIu64
+           " SBC bytes; sequence gaps=%" PRIu32 ", duplicates=%" PRIu32
+           ", reordered=%" PRIu32 "\n",
+           s31_media_packets, s31_media_bytes, s31_media_sequence_gaps,
+           s31_media_duplicate_packets, s31_media_reordered_packets);
+}
+
+static void s31_media_track_sequence(uint16_t sequence_number){
+    uint16_t advance;
+
+    if (!s31_media_sequence_valid){
+        s31_media_sequence_valid = true;
+        s31_media_last_sequence = sequence_number;
+        return;
+    }
+    if (sequence_number == s31_media_last_sequence){
+        s31_media_duplicate_packets++;
+        return;
+    }
+
+    advance = (uint16_t)(sequence_number - s31_media_last_sequence);
+    if (advance < 0x8000){
+        if (advance > 1){
+            s31_media_sequence_gaps += advance - 1;
+        }
+        s31_media_last_sequence = sequence_number;
+    } else {
+        s31_media_reordered_packets++;
+    }
+}
+
 static void handle_l2cap_media_data_packet(uint8_t seid, uint8_t *packet, uint16_t size){
     UNUSED(seid);
     int pos = 0;
@@ -676,6 +713,10 @@ static void handle_l2cap_media_data_packet(uint8_t seid, uint8_t *packet, uint16
 
     s31_media_packets++;
     s31_media_bytes += packet_length;
+    s31_media_track_sequence(media_header.sequence_number);
+    if ((s31_media_packets & 0x7ff) == 0){
+        s31_media_report();
+    }
 
 #if S31_BTSTACK_TRANSPORT_ONLY
     UNUSED(packet_begin);
@@ -1415,8 +1456,13 @@ static void a2dp_sink_packet_handler(uint8_t packet_type, uint16_t channel, uint
         case A2DP_SUBEVENT_STREAM_STARTED:
             printf("A2DP  Sink      : Stream started\n");
             s31_media_packets = 0;
-            s31_coex_request(true);
             s31_media_bytes = 0;
+            s31_media_sequence_valid = false;
+            s31_media_last_sequence = 0;
+            s31_media_sequence_gaps = 0;
+            s31_media_duplicate_packets = 0;
+            s31_media_reordered_packets = 0;
+            s31_coex_request(true);
             a2dp_conn->stream_state = STREAM_STATE_PLAYING;
             if (a2dp_conn->sbc_configuration.reconfigure){
                 media_processing_close();
@@ -1427,8 +1474,7 @@ static void a2dp_sink_packet_handler(uint8_t packet_type, uint16_t channel, uint
         
         case A2DP_SUBEVENT_STREAM_SUSPENDED:
             printf("A2DP  Sink      : Stream paused\n");
-            printf("A2DP  Sink      : Received %" PRIu32 " media packets, %" PRIu64 " SBC bytes\n",
-                   s31_media_packets, s31_media_bytes);
+            s31_media_report();
             a2dp_conn->stream_state = STREAM_STATE_PAUSED;
             s31_coex_request(false);
             media_processing_pause();
-- 
