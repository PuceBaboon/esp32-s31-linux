From 1b0bc4fe2b4026da95d7e3972afdd4e6d4715f04 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Sat, 29 Aug 2026 19:00:00 +0800
Subject: [PATCH] linux: retry direct HCI writes after backpressure

The S31 direct-HCI character device is nonblocking.  During simultaneous A2DP
and Wi-Fi traffic, a Host Number Of Completed Packets command can encounter a
full kernel TX ring.  Treat that as normal transport backpressure: retain the
BTstack-owned packet, wait for POLLOUT, retry it unchanged, and emit the normal
asynchronous transport-sent event only after the kernel accepts it.
---
 platform/linux/hci_transport_linux.c | 77 ++++++++++++++++++++++++++++--------
 1 file changed, 60 insertions(+), 17 deletions(-)

diff --git a/platform/linux/hci_transport_linux.c b/platform/linux/hci_transport_linux.c
index 4ea2080ae..5cc113f65 100644
--- a/platform/linux/hci_transport_linux.c
+++ b/platform/linux/hci_transport_linux.c
@@ -77,8 +77,46 @@ static uint8_t s31_hci_batch[S31_HCI_BATCH_PACKETS * S31_HCI_BATCH_RECORD_SIZE];
 // linux hci socket
 static int hci_socket = -1;
 
+static uint8_t * hci_pending_write;
+static uint32_t hci_pending_write_size;
+static int hci_can_send;
+static btstack_context_callback_registration_t hci_packet_sent_registration;
+
 static const hci_transport_config_linux_t * hci_transport_config_linux;
 
+static void hci_transport_linux_emit_packet_sent(void * context) {
+    UNUSED(context);
+    static const uint8_t packet_sent_event[] = { HCI_EVENT_TRANSPORT_PACKET_SENT, 0 };
+
+    hci_can_send = 1;
+    hci_transport_linux_packet_handler(HCI_EVENT_PACKET,
+                                       (uint8_t *) packet_sent_event,
+                                       sizeof(packet_sent_event));
+}
+
+static void hci_transport_linux_schedule_packet_sent(void) {
+    hci_packet_sent_registration.callback = &hci_transport_linux_emit_packet_sent;
+    hci_packet_sent_registration.context = NULL;
+    btstack_run_loop_execute_on_main_thread(&hci_packet_sent_registration);
+}
+
+static void hci_transport_linux_process_write(btstack_data_source_t * ds) {
+    ssize_t bytes_written;
+
+    btstack_assert(hci_pending_write != NULL);
+    bytes_written = write(hci_socket, hci_pending_write, hci_pending_write_size);
+    if (bytes_written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+    if (bytes_written < 0) {
+        perror("Failed to retry HCI packet");
+        return;
+    }
+    btstack_assert((uint32_t) bytes_written == hci_pending_write_size);
+    hci_pending_write = NULL;
+    hci_pending_write_size = 0;
+    btstack_run_loop_disable_data_source_callbacks(ds, DATA_SOURCE_CALLBACK_WRITE);
+    hci_transport_linux_schedule_packet_sent();
+}
+
 static void hci_transport_linux_process_read(btstack_data_source_t * ds) {
     UNUSED(ds);
     int packets;
@@ -126,6 +164,9 @@ static void hci_transport_linux_process(btstack_data_source_t *ds, btstack_data_source_callback_type_t callback_type) {
         case DATA_SOURCE_CALLBACK_READ:
             hci_transport_linux_process_read(ds);
             break;
+        case DATA_SOURCE_CALLBACK_WRITE:
+            hci_transport_linux_process_write(ds);
+            break;
         default:
             break;
     }
@@ -150,6 +191,9 @@ static int hci_transport_linux_open(void) {
     btstack_run_loop_add_data_source(&hci_transport_linux_data_source);
     btstack_run_loop_enable_data_source_callbacks(&hci_transport_linux_data_source, DATA_SOURCE_CALLBACK_READ);
 
+    hci_pending_write = NULL;
+    hci_pending_write_size = 0;
+    hci_can_send = 1;
     return 0;
 }
 
@@ -169,16 +213,32 @@ static void hci_transport_linux_register_packet_handler(void (*handler)(uint8_t packet_type, uint8_t *packet, uint16_t size)){
     hci_transport_linux_packet_handler = handler;
 }
 
+static int hci_transport_linux_can_send_packet_now(uint8_t packet_type) {
+    UNUSED(packet_type);
+    return hci_can_send;
+}
+
 static int hci_transport_linux_send_packet(uint8_t packet_type, uint8_t * packet, int size) {
     // store packet type before actual data and increase size
     uint8_t * buffer = &packet[-1];
     uint32_t  buffer_size = size + 1;
     buffer[0] = packet_type;
 
-    if (write(hci_socket, buffer, buffer_size) < 0) {
+    btstack_assert(hci_can_send != 0);
+    hci_can_send = 0;
+    if (write(hci_socket, buffer, buffer_size) < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            hci_pending_write = buffer;
+            hci_pending_write_size = buffer_size;
+            btstack_run_loop_enable_data_source_callbacks(&hci_transport_linux_data_source,
+                                                           DATA_SOURCE_CALLBACK_WRITE);
+            return 0;
+        }
         perror("Failed to send HCI packet");
+        hci_can_send = 1;
         return -1;
     }
+    hci_transport_linux_schedule_packet_sent();
     return 0;
 }
 
@@ -189,5 +249,6 @@ static const hci_transport_t hci_transport_linux = {
     .close = &hci_transport_linux_close,
     .register_packet_handler = &hci_transport_linux_register_packet_handler,
+    .can_send_packet_now = &hci_transport_linux_can_send_packet_now,
     .send_packet = &hci_transport_linux_send_packet
 };
 
-- 
2.43.0
