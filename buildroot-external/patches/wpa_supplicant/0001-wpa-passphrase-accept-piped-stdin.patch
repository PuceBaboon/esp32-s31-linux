From 2e686949ad80f6a30e502a3746053865326a33ba Mon Sep 17 00:00:00 2001
From: GrieferPig <grieferpig@users.noreply.github.com>
Date: Mon, 24 Aug 2026 23:55:00 +0800
Subject: [PATCH] wpa_passphrase: accept a passphrase from piped stdin

wpa_passphrase documents that an omitted passphrase is read from stdin,
but currently treats tcgetattr() failure as fatal. This prevents callers from
supplying the passphrase over a pipe and forces automation to expose it in the
process argument list.

Only manipulate terminal echo when stdin is a terminal. For a pipe, read the
line directly with fgets(). Interactive behavior is unchanged.

Signed-off-by: GrieferPig <grieferpig@users.noreply.github.com>
---
 wpa_supplicant/wpa_passphrase.c | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

diff --git a/wpa_supplicant/wpa_passphrase.c b/wpa_supplicant/wpa_passphrase.c
index 9c64a44..8d6bb41 100644
--- a/wpa_supplicant/wpa_passphrase.c
+++ b/wpa_supplicant/wpa_passphrase.c
@@ -36,12 +36,15 @@ int main(int argc, char *argv[])
 		bool ctrl_echo;
 
 		fprintf(stderr, "# reading passphrase from stdin\n");
-		if (tcgetattr(STDIN_FILENO, &term) < 0) {
-			perror("tcgetattr");
-			return 1;
+		ctrl_echo = false;
+		if (isatty(STDIN_FILENO)) {
+			if (tcgetattr(STDIN_FILENO, &term) < 0) {
+				perror("tcgetattr");
+				return 1;
+			}
+			ctrl_echo = term.c_lflag & ECHO;
+			term.c_lflag &= ~ECHO;
 		}
-		ctrl_echo = term.c_lflag & ECHO;
-		term.c_lflag &= ~ECHO;
 		if (ctrl_echo && tcsetattr(STDIN_FILENO, TCSANOW, &term) < 0) {
 			perror("tcsetattr:error disabling echo");
 			return 1;
