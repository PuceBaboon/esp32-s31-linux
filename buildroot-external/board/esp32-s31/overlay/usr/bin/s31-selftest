#!/bin/sh

# User-facing ESP32-S31 health and concurrency test. The stress path writes
# only a bounded probe below /var/lib and never changes radio configuration,
# module ownership, raw flash contents, or HCI state.

set -u

MODE=quick
MODE_SET=0
JSON=0
DURATION=60
REQUIRE_RADIO_TRAFFIC=0
PASS_COUNT=0
FAIL_COUNT=0
SKIP_COUNT=0
ROOT="${S31_SELFTEST_ROOT:-}"
WORKDIR="${S31_SELFTEST_WORKDIR:-${ROOT}/var/lib/s31-selftest}"
RUNTIME_DIR="${ROOT}/tmp"
DMESG_FILE="${S31_SELFTEST_DMESG_FILE:-}"
TEST_MODE="${S31_SELFTEST_TEST_MODE:-0}"
NO_TASKSET="${S31_SELFTEST_NO_TASKSET:-0}"
PIDS=""
CLEANUP_FILES=""
STOP_FILE=""

usage()
{
	cat >&2 <<EOF
usage: $0 [--quick|--stress] [--json] [--duration SECONDS]

  --quick             Run bounded health and one small persist write test.
  --stress            Add concurrent SMP, XIP read, persist write, and
                      read-only radio-health pressure (default: 60 seconds).
  --json              Emit one JSON object per result.
  --duration SECONDS  Stress duration, 10..3600 seconds.
  --require-radio-traffic
                      Fail unless Wi-Fi or Bluetooth packet counters grow.
EOF
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	--quick|--stress)
		[ "$MODE_SET" -eq 0 ] || { usage; exit 2; }
		MODE="${1#--}"
		MODE_SET=1
		shift
		;;
	--json)
		JSON=1
		shift
		;;
	--duration)
		[ "$#" -ge 2 ] || { usage; exit 2; }
		DURATION="$2"
		shift 2
		;;
	--require-radio-traffic)
		REQUIRE_RADIO_TRAFFIC=1
		shift
		;;
	-h|--help)
		usage
		exit 0
		;;
	*)
		usage
		exit 2
		;;
	esac
done

case "$DURATION" in
''|*[!0-9]*) usage; exit 2 ;;
esac
if [ "$MODE" = stress ]; then
	if [ "$TEST_MODE" = 1 ]; then
		[ "$DURATION" -ge 1 ] && [ "$DURATION" -le 3600 ] || { usage; exit 2; }
	else
		[ "$DURATION" -ge 10 ] && [ "$DURATION" -le 3600 ] || { usage; exit 2; }
	fi
elif [ "$DURATION" -ne 60 ]; then
	echo "--duration requires --stress" >&2
	exit 2
fi
if [ "$REQUIRE_RADIO_TRAFFIC" -eq 1 ] && [ "$MODE" != stress ]; then
	echo "--require-radio-traffic requires --stress" >&2
	exit 2
fi

json_escape()
{
	printf '%s' "$1" | tr '\r\n' '  ' |
		sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'
}

emit()
{
	_emit_status="$1"
	_emit_name="$2"
	_emit_level="$3"
	_emit_detail="$(printf '%s' "$4" | tr '\r\n' '  ' | cut -c1-320)"
	case "$_emit_status" in
	PASS) PASS_COUNT=$((PASS_COUNT + 1)) ;;
	FAIL) FAIL_COUNT=$((FAIL_COUNT + 1)) ;;
	SKIP) SKIP_COUNT=$((SKIP_COUNT + 1)) ;;
	esac
	if [ "$JSON" -eq 1 ]; then
		printf '{"schema":"s31-selftest/1","status":"%s","test":"%s","level":"%s","detail":"%s"}\n' \
			"$(json_escape "$_emit_status")" "$(json_escape "$_emit_name")" \
			"$(json_escape "$_emit_level")" "$(json_escape "$_emit_detail")"
	else
		printf '%-4s %-24s %s\n' "$_emit_status" "$_emit_name" "$_emit_detail"
	fi
}

emit_summary()
{
	_summary_status=PASS
	[ "$FAIL_COUNT" -eq 0 ] || _summary_status=FAIL
	if [ "$JSON" -eq 1 ]; then
		printf '{"schema":"s31-selftest/1","status":"%s","test":"summary","level":"summary","mode":"%s","duration":%u,"pass":%u,"fail":%u,"skip":%u}\n' \
			"$_summary_status" "$MODE" "$DURATION" "$PASS_COUNT" "$FAIL_COUNT" "$SKIP_COUNT"
	else
		printf '%s mode=%s duration=%ss pass=%u fail=%u skip=%u\n' \
			"$_summary_status" "$MODE" "$DURATION" "$PASS_COUNT" "$FAIL_COUNT" "$SKIP_COUNT"
	fi
}

cleanup()
{
	[ -z "$STOP_FILE" ] || : >"$STOP_FILE" 2>/dev/null || true
	for _pid in $PIDS; do
		kill "$_pid" >/dev/null 2>&1 || true
	done
	for _pid in $PIDS; do
		wait "$_pid" >/dev/null 2>&1 || true
	done
	[ -z "$CLEANUP_FILES" ] || rm -f $CLEANUP_FILES >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

read_file()
{
	cat "${ROOT}$1" 2>/dev/null
}

find_radio_health()
{
	find "${ROOT}/sys" -type f -name radio_health 2>/dev/null | head -n 1
}

capture_dmesg()
{
	if [ -n "$DMESG_FILE" ]; then
		cat "$DMESG_FILE" 2>/dev/null || true
	else
		dmesg 2>/dev/null || true
	fi
}

health_metric()
{
	printf '%s\n' "$1" | tr ' ' '\n' |
		sed -n "s/^$2=//p" | tail -n 1
}

quick_board()
{
	_model="$(read_file /proc/device-tree/model | tr -d '\000')"
	case "$_model" in
	*ESP32-S31*) emit PASS board.identity probe "$_model" ;;
	*) emit FAIL board.identity probe "unexpected model: ${_model:-unavailable}" ;;
	esac
}

quick_smp()
{
	_online="$(read_file /sys/devices/system/cpu/online | tr -d '[:space:]')"
	case "$_online" in
	0-1|0,1) emit PASS cpu.smp probe "online=$_online" ;;
	*) emit FAIL cpu.smp probe "expected CPUs 0-1 online, got ${_online:-unavailable}" ;;
	esac
}

quick_xip()
{
	_kallsyms="${ROOT}/proc/kallsyms"
	_mtd="${ROOT}/proc/mtd"
	if [ -r "$_kallsyms" ] &&
	   grep -Eq '^[0-9a-fA-F]*[1-9a-fA-F][0-9a-fA-F]* [a-zA-Z] _xiprom$' "$_kallsyms"; then
		_xip="$(awk '$3 == "_xiprom" { print $1; exit }' "$_kallsyms")"
		emit PASS kernel.xip probe "_xiprom=$_xip"
	elif [ -r "${ROOT}/proc/iomem" ] &&
	     grep -Eq '^40000000-40efffff : 40000000\.flash flash@40000000$' "${ROOT}/proc/iomem" &&
	     [ -r "$_mtd" ] &&
	     grep -Eq '^mtd[0-9]+: [0-9a-fA-F]+ [0-9a-fA-F]+ "linux"$' "$_mtd"; then
		emit PASS kernel.xip probe "runtime XIP Flash window 0x40000000..0x40efffff; linux MTD present; kallsyms unavailable"
	else
		emit FAIL kernel.xip probe "neither _xiprom nor exact XIP iomem plus linux MTD evidence is available"
	fi
	if [ -r "$_mtd" ] && grep -q '"linux"' "$_mtd" && grep -q '"persist"' "$_mtd"; then
		emit PASS flash.layout probe "linux and persist MTD partitions present"
	else
		emit FAIL flash.layout probe "linux/persist MTD partition missing"
	fi
}

quick_persist()
{
	_probe="$WORKDIR/.quick-probe-$$"
	if ! mkdir -p "$WORKDIR" 2>/dev/null; then
		emit FAIL flash.persist data "cannot create $WORKDIR"
		return
	fi
	CLEANUP_FILES="$CLEANUP_FILES $_probe"
	if printf 's31-selftest:%s\n' "$$" >"$_probe" 2>/dev/null &&
	   sync && _sum0="$(cksum "$_probe" 2>/dev/null)" &&
	   _sum1="$(cksum "$_probe" 2>/dev/null)" && [ "$_sum0" = "$_sum1" ]; then
		emit PASS flash.persist data "small write, sync, and readback passed"
	else
		emit FAIL flash.persist data "small write/sync/readback failed"
	fi
	rm -f "$_probe" 2>/dev/null || true
	sync
}

quick_radio()
{
	_health_file="$(find_radio_health)"
	if [ -n "$_health_file" ] && _health="$(cat "$_health_file" 2>/dev/null)" &&
	   [ -n "$_health" ]; then
		emit PASS radio.health probe "$(printf '%s' "$_health" | cut -c1-240)"
	else
		emit SKIP radio.health probe "radio health endpoint not present"
	fi
	if [ -d "${ROOT}/sys/class/net/wlan0" ]; then
		_state="$(cat "${ROOT}/sys/class/net/wlan0/operstate" 2>/dev/null || echo unknown)"
		emit PASS radio.wifi probe "wlan0 present, operstate=$_state"
	else
		emit SKIP radio.wifi probe "wlan0 not registered in this profile"
	fi
	if [ -d "${ROOT}/sys/class/bluetooth/hci0" ]; then
		emit PASS radio.bluetooth probe "hci0 present"
	elif [ -c "${ROOT}/dev/s31-hci" ]; then
		emit PASS radio.bluetooth probe "/dev/s31-hci present"
	else
		emit SKIP radio.bluetooth probe "no HCI frontend in this profile"
	fi
}

quick_memory()
{
	_mem="$(awk '/^MemAvailable:/ { print $2; exit }' "${ROOT}/proc/meminfo" 2>/dev/null)"
	case "$_mem" in
	''|*[!0-9]*) emit FAIL memory.available probe "MemAvailable unavailable" ;;
	*) emit PASS memory.available probe "${_mem} KiB" ;;
	esac
}

run_quick()
{
	quick_board
	quick_smp
	quick_xip
	quick_persist
	quick_radio
	quick_memory
}

cpu_worker()
{
	_cpu="$1"
	_seed="$2"
	_result="$3"
	_count=0
	while [ ! -e "$STOP_FILE" ]; do
		if [ "$NO_TASKSET" -eq 0 ] && command -v taskset >/dev/null 2>&1; then
			taskset -c "$_cpu" sha256sum "$_seed" >/dev/null 2>&1 || {
				printf 'FAIL taskset/sha256 cpu%s\n' "$_cpu" >"$_result"
				return 1
			}
		else
			sha256sum "$_seed" >/dev/null 2>&1 || {
				printf 'FAIL sha256 cpu%s\n' "$_cpu" >"$_result"
				return 1
			}
		fi
		_count=$((_count + 1))
	done
	printf 'PASS %u\n' "$_count" >"$_result"
}

xip_worker()
{
	_device="$1"
	_result="$2"
	_count=0
	while [ ! -e "$STOP_FILE" ]; do
		if ! dd if="$_device" of=/dev/null bs=4096 count=64 2>/dev/null; then
			printf 'FAIL read %s\n' "$_device" >"$_result"
			return 1
		fi
		_count=$((_count + 1))
	done
	printf 'PASS %u\n' "$_count" >"$_result"
}

flash_worker()
{
	_seed="$1"
	_result="$2"
	_final="$WORKDIR/stress-probe"
	_tmp="$WORKDIR/.stress-probe-$$"
	_count=0
	CLEANUP_FILES="$CLEANUP_FILES $_final $_tmp"
	while [ ! -e "$STOP_FILE" ]; do
		_count=$((_count + 1))
		if ! { printf '%08u\n' "$_count"; cat "$_seed"; } >"$_tmp" 2>/dev/null; then
			printf 'FAIL write iteration %u\n' "$_count" >"$_result"
			return 1
		fi
		_expected="$(cksum "$_tmp" 2>/dev/null | awk '{ print $1 ":" $2 }')" || {
			printf 'FAIL checksum iteration %u\n' "$_count" >"$_result"
			return 1
		}
		if ! sync || ! mv -f "$_tmp" "$_final" || ! sync; then
			printf 'FAIL commit iteration %u\n' "$_count" >"$_result"
			return 1
		fi
		_actual="$(cksum "$_final" 2>/dev/null | awk '{ print $1 ":" $2 }')" || _actual=failed
		if [ "$_actual" != "$_expected" ]; then
			printf 'FAIL readback iteration %u\n' "$_count" >"$_result"
			return 1
		fi
	done
	printf 'PASS %u\n' "$_count" >"$_result"
}

radio_worker()
{
	_health_file="$1"
	_result="$2"
	_count=0
	_last=""
	while [ ! -e "$STOP_FILE" ]; do
		_last="$(cat "$_health_file" 2>/dev/null)" || {
			printf 'FAIL health endpoint unreadable\n' >"$_result"
			return 1
		}
		[ -n "$_last" ] || {
			printf 'FAIL empty health sample\n' >"$_result"
			return 1
		}
		_count=$((_count + 1))
		sleep 1
	done
	printf 'PASS %u %s\n' "$_count" "$_last" >"$_result"
}

worker_result()
{
	_name="$1"
	_file="$2"
	if [ ! -r "$_file" ]; then
		emit FAIL "$_name" stress "worker produced no result"
		return
	fi
	_line="$(cat "$_file")"
	case "$_line" in
	PASS\ *) emit PASS "$_name" stress "${_line#PASS } iterations/samples" ;;
	*) emit FAIL "$_name" stress "${_line#FAIL }" ;;
	esac
}

run_stress()
{
	_health_file="$(find_radio_health)"
	if [ -z "$_health_file" ] || ! _health_before="$(cat "$_health_file" 2>/dev/null)" ||
	   [ -z "$_health_before" ]; then
		emit FAIL stress.preflight probe "radio health endpoint is required"
		return
	fi
	_wlan_rx_before="$(cat "${ROOT}/sys/class/net/wlan0/statistics/rx_packets" 2>/dev/null || echo 0)"
	_wlan_tx_before="$(cat "${ROOT}/sys/class/net/wlan0/statistics/tx_packets" 2>/dev/null || echo 0)"
	_mtd_name="$(sed -n 's/^\(mtd[0-9][0-9]*\):.*"linux"$/\1/p' "${ROOT}/proc/mtd" | head -n 1)"
	_xip_device="${S31_SELFTEST_XIP_DEVICE:-${ROOT}/dev/${_mtd_name}}"
	if [ -z "$_mtd_name" ] || [ ! -r "$_xip_device" ]; then
		emit FAIL stress.preflight probe "readable Linux XIP MTD device unavailable"
		return
	fi
	if ! mkdir -p "$WORKDIR" "$RUNTIME_DIR" 2>/dev/null; then
		emit FAIL stress.preflight probe "cannot create runtime/work directory"
		return
	fi
	_seed="$RUNTIME_DIR/s31-selftest.seed.$$"
	STOP_FILE="$RUNTIME_DIR/s31-selftest.stop.$$"
	_cpu0="$RUNTIME_DIR/s31-selftest.cpu0.$$"
	_cpu1="$RUNTIME_DIR/s31-selftest.cpu1.$$"
	_xip="$RUNTIME_DIR/s31-selftest.xip.$$"
	_flash="$RUNTIME_DIR/s31-selftest.flash.$$"
	_radio="$RUNTIME_DIR/s31-selftest.radio.$$"
	_log0="$RUNTIME_DIR/s31-selftest.dmesg0.$$"
	_log1="$RUNTIME_DIR/s31-selftest.dmesg1.$$"
	_lognew="$RUNTIME_DIR/s31-selftest.dmesg-new.$$"
	CLEANUP_FILES="$CLEANUP_FILES $_seed $STOP_FILE $_cpu0 $_cpu1 $_xip $_flash $_radio $_log0 $_log1 $_lognew $WORKDIR/stress-probe $WORKDIR/.stress-probe-$$"
	rm -f "$STOP_FILE"
	if ! dd if=/dev/zero of="$_seed" bs=1024 count=64 2>/dev/null; then
		emit FAIL stress.preflight probe "cannot create 64 KiB RAM seed"
		return
	fi
	capture_dmesg >"$_log0"
	emit PASS stress.preflight probe "duration=${DURATION}s xip=$_xip_device radio=$_health_file"

	cpu_worker 0 "$_seed" "$_cpu0" & _cpu0_pid=$!; PIDS="$PIDS $_cpu0_pid"
	cpu_worker 1 "$_seed" "$_cpu1" & _cpu1_pid=$!; PIDS="$PIDS $_cpu1_pid"
	xip_worker "$_xip_device" "$_xip" & _xip_pid=$!; PIDS="$PIDS $_xip_pid"
	flash_worker "$_seed" "$_flash" & _flash_pid=$!; PIDS="$PIDS $_flash_pid"
	radio_worker "$_health_file" "$_radio" & _radio_pid=$!; PIDS="$PIDS $_radio_pid"

	sleep "$DURATION"
	: >"$STOP_FILE"
	wait "$_cpu0_pid" >/dev/null 2>&1 || true
	wait "$_cpu1_pid" >/dev/null 2>&1 || true
	wait "$_xip_pid" >/dev/null 2>&1 || true
	wait "$_flash_pid" >/dev/null 2>&1 || true
	wait "$_radio_pid" >/dev/null 2>&1 || true
	PIDS=""

	worker_result stress.cpu0 "$_cpu0"
	worker_result stress.cpu1 "$_cpu1"
	worker_result stress.xip-read "$_xip"
	worker_result stress.persist-write "$_flash"
	worker_result stress.radio-health "$_radio"

	_online_after="$(read_file /sys/devices/system/cpu/online | tr -d '[:space:]')"
	case "$_online_after" in
	0-1|0,1) emit PASS stress.smp-online stress "online=$_online_after after load" ;;
	*) emit FAIL stress.smp-online stress "CPUs changed to ${_online_after:-unavailable}" ;;
	esac

	_health_after="$(cat "$_health_file" 2>/dev/null || true)"
	if [ "$REQUIRE_RADIO_TRAFFIC" -eq 1 ]; then
		_acl_rx_before="$(health_metric "$_health_before" acl_rx_packets)"
		_acl_tx_before="$(health_metric "$_health_before" acl_tx_packets)"
		_acl_rx_after="$(health_metric "$_health_after" acl_rx_packets)"
		_acl_tx_after="$(health_metric "$_health_after" acl_tx_packets)"
		_wlan_rx_after="$(cat "${ROOT}/sys/class/net/wlan0/statistics/rx_packets" 2>/dev/null || echo 0)"
		_wlan_tx_after="$(cat "${ROOT}/sys/class/net/wlan0/statistics/tx_packets" 2>/dev/null || echo 0)"
		for _counter in _acl_rx_before _acl_tx_before _acl_rx_after _acl_tx_after \
			_wlan_rx_before _wlan_tx_before _wlan_rx_after _wlan_tx_after; do
			eval "_value=\${$_counter}"
			case "$_value" in ''|*[!0-9]*) eval "$_counter=0" ;; esac
		done
		_acl_delta=$((_acl_rx_after + _acl_tx_after - _acl_rx_before - _acl_tx_before))
		_wlan_delta=$((_wlan_rx_after + _wlan_tx_after - _wlan_rx_before - _wlan_tx_before))
		if [ "$((_acl_delta + _wlan_delta))" -gt 0 ]; then
			emit PASS stress.radio-traffic stress "ACL=+$_acl_delta Wi-Fi=+$_wlan_delta packets"
		else
			emit FAIL stress.radio-traffic stress "no Wi-Fi or Bluetooth packet progress"
		fi
	fi
	_drop_detail=""
	_drop_failed=0
	for _metric in wifi_rx_dropped wifi_tx_dropped hci_rx_dropped hci_tx_dropped; do
		_before="$(health_metric "$_health_before" "$_metric")"
		_after="$(health_metric "$_health_after" "$_metric")"
		case "$_before:$_after" in
		*[!0-9:]*|:*) _drop_detail="$_drop_detail $_metric=n/a" ;;
		*)
			_delta=$((_after - _before))
			_drop_detail="$_drop_detail $_metric=+$_delta"
			[ "$_delta" -eq 0 ] || _drop_failed=1
			;;
		esac
	done
	if [ "$_drop_failed" -eq 0 ]; then
		emit PASS stress.radio-drops stress "${_drop_detail# }"
	else
		emit FAIL stress.radio-drops stress "${_drop_detail# }"
	fi

	capture_dmesg >"$_log1"
	_before_lines="$(wc -l <"$_log0")"
	awk -v first="$((_before_lines + 1))" 'NR >= first' "$_log1" >"$_lognew"
	if grep -Eiq 'Kernel panic|Oops:|BUG:|WARNING:|soft lockup|hard LOCKUP|rcu.*stall|watchdog.*(lockup|reset|timeout)|I/O error|JFFS2 error|jffs2.*failed|mtd.*failed' "$_lognew"; then
		_errors="$(grep -Ei 'Kernel panic|Oops:|BUG:|WARNING:|soft lockup|hard LOCKUP|rcu.*stall|watchdog.*(lockup|reset|timeout)|I/O error|JFFS2 error|jffs2.*failed|mtd.*failed' "$_lognew" | head -n 3 | tr '\r\n' '  ')"
		emit FAIL stress.kernel-log stress "$_errors"
	else
		emit PASS stress.kernel-log stress "no new panic/oops/lockup/watchdog/MTD/JFFS2 error"
	fi
	rm -f "$WORKDIR/stress-probe" "$WORKDIR/.stress-probe-$$" 2>/dev/null || true
	sync
}

run_quick
if [ "$MODE" = stress ]; then
	if [ "$FAIL_COUNT" -eq 0 ]; then
		run_stress
	else
		emit SKIP stress.run stress "quick preflight failed"
	fi
fi

emit_summary
[ "$FAIL_COUNT" -eq 0 ]
