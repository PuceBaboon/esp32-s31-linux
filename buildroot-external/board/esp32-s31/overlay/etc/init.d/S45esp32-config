#!/bin/sh

case "$1" in
start)
	printf 'Applying ESP32 persistent configuration: '
	result=0
	/usr/sbin/esp32-config apply system || result=1
	# S00 loads both radio clients and S40btstack opens the controller first.
	# Associate only after that shared-core handoff so coexistence never joins
	# an already-running Wi-Fi data path.
	/usr/sbin/esp32-config apply wifi || result=1
	if [ "$result" -eq 0 ]; then
		echo 'OK'
	else
		echo 'PARTIAL'
	fi
	;;
stop)
	/usr/sbin/esp32-config stop >/dev/null 2>&1 || true
	;;
restart|reload)
	"$0" stop
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac

exit 0
