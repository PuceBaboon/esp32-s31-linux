menu "S31 A2DP/Wi-Fi coexistence benchmark"

    config BENCH_WIFI_SSID
        string "Wi-Fi station SSID"
        default ""

    config BENCH_WIFI_PASSWORD
        string "Wi-Fi station password"
        default ""

    config BENCH_TCP_PORT
        int "TCP receive benchmark port"
        range 1 65535
        default 3333

    config BENCH_TCP_RCVBUF
        int "TCP socket receive buffer"
        range 4096 65535
        default 32768

endmenu
